# Copy this file to ".env.local" and fill in the empty values. Never share or commit .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key ("service_role" / "secret"). SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=support.wearcast@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=support.wearcast@gmail.com

# --- Fal.ai (fal.ai dashboard > Keys). Used by the asset script and try-on, server only ---
FAL_KEY=

# --- Google Gemini (Google AI Studio) ---
GEMINI_API_KEY=

# --- OpenWeatherMap ---
OPENWEATHER_API_KEY=

# --- Launch discount switch (true = 40% off prices, false = normal prices) ---
NEXT_PUBLIC_LAUNCH_DISCOUNT=true

# --- Payments: m10_manual | disabled ---
PAYMENT_PROVIDER=disabled
